    "Kein Pausieren: Wer die App länger als 30 Sekunden verlässt, gibt auf." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pausing: if you leave the app for more than 30 seconds, you give up."
          }
        }
      }
    },
    "Kein Pausieren: Wer die App länger als 30 Sekunden verlässt, ist draußen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pausing: if you leave the app for more than 30 seconds, you’re out."
          }
        }
      }
    },
    "Keine %@ passen zu diesen Einstellungen." : {
